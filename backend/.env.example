# ==============================================================
# AI Interview Preparation Platform - Environment Configuration
# ==============================================================

# Application Security
# IMPORTANT: Generate a strong, unique secret key for production environments:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In local development, if unset, a development default key is used.
SECRET_KEY=your_generated_random_secret_key_here
DATABASE_URL=sqlite:///./ai_interview.db

# --------------------------------------------------------------
# Natural Human-Like Text-to-Speech (TTS) Settings
# --------------------------------------------------------------
# TTS_PROVIDER options:
#  - "edge-tts": (DEFAULT) High-fidelity Microsoft Neural Speech.
#                Zero cost, 100% free, no API key required.
#  - "elevenlabs": ElevenLabs Speech API (requires ELEVENLABS_API_KEY).
TTS_PROVIDER=edge-tts

# Natural Interviewer Voice:
#  - "en-US-JennyNeural" (Default: Warm, natural, professional American female)
#  - "en-US-GuyNeural"   (Natural, confident, professional American male)
#  - "en-US-AriaNeural"  (Clear, conversational American female)
#  - "en-US-ChristopherNeural" (Calm, articulate American male)
TTS_VOICE=en-US-JennyNeural

# Conversational Pacing (e.g., "+0%", "-2%", "+5%")
TTS_RATE=+0%
TTS_PITCH=+0Hz

# (Optional) ElevenLabs Configuration
# If you want to use ElevenLabs, set your API key below.
# If unset or if quota is exceeded, the platform seamlessly falls back to Edge Neural TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --------------------------------------------------------------
# (Optional) Gemini Generative AI Settings
# --------------------------------------------------------------
# If left empty, the platform automatically uses the built-in RuleBasedNLPProvider
# with zero external API calls or network dependency.
GEMINI_API_KEY=
