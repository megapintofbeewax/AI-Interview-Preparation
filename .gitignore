# Python virtual environment
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode & Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend build output
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
.eslintcache

# Environment variables & local secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# SQLite Databases & sidecar files (WAL, SHM)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
ai_interview.db*
backend/ai_interview.db*

# User uploads, resumes, audio recordings, TTS cache
uploads/
backend/uploads/
*.mp3
*.wav
*.ogg
*.m4a
*.webm

